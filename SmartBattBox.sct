; Scatter file for STM32F407VGTX (Keil ARMCLINK)
; 1024KB Flash, 128KB RAM, 64KB CCMRAM

LR_IROM1 0x08000000 0x000E0000  {    ; load region = 1024KB Flash
  ER_IROM1 0x08000000 0x000E0000  {  ; execution region
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; 128KB RAM
   .ANY (+RW +ZI)
  }
  RW_IRAM2 0x10000000 0x00010000  {  ; 64KB CCMRAM
   *(.ccmram)
  }
}
